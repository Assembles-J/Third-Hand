# Copy this file to .env on the deployment server. Never commit the real .env.
API_PORT=8000
# Optional personal-research A-share end-of-day provider. Never commit a real token.
THIRD_HAND_MARKET_PROVIDER=akshare
TUSHARE_TOKEN=
DEEPSEEK_API_KEY=
# Python package mirror used when building the API image. Change these if needed.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# The public HTTPS address of this API, without a trailing slash.
APP_PUBLIC_BASE_URL=https://api.example.com
# Copy the signed APK to ./releases on the server, then set its filename here.
APP_UPDATE_APK_FILE=
APP_UPDATE_VERSION_CODE=1
APP_UPDATE_VERSION_NAME=0.1.0
APP_UPDATE_CHANGELOG=
