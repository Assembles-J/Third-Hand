# Copy this file to .env on the deployment server. Never commit the real .env.
API_PORT=8000
# Optional personal-research A-share end-of-day provider. Never commit a real token.
THIRD_HAND_MARKET_PROVIDER=akshare
MARKET_REFRESH_ENABLED=true
MARKET_REFRESH_INTERVAL_SECONDS=60
# Whole-market opportunity scan: refreshes A-share snapshot and queues a bounded
# set of hot-sector candidates for daily-history analysis while the market is open.
MARKET_UNIVERSE_SCAN_INTERVAL_SECONDS=300
THIRD_HAND_LOG_LEVEL=INFO
TUSHARE_TOKEN=
DEEPSEEK_API_KEY=
# 决策报告的运行模式：true 表示保留每次分析快照，仅用于研究和纸面复核，不会自动下单。
DECISION_SHADOW_MODE=true
# 是否启用仓位测算：根据资金、仓位上限、风险预算和整手规则给出数量候选；不会执行交易。
DECISION_SIZING_ENABLED=true
# 是否启用受约束的 DeepSeek 研究：只解释已有证据，不能绕过风控或生成交易数量；需要 DEEPSEEK_API_KEY。
DECISION_AI_ENABLED=true
DECISION_AI_MAX_TOKENS=1200
# Research Chat starts disabled.  Stage 1 uses only a local fake SSE stream.
RESEARCH_CHAT_ENABLED=false
RESEARCH_CHAT_SSE_ENABLED=false
RESEARCH_CHAT_REASONING_VISIBLE=false
RESEARCH_CHAT_TOOL_CALLING_ENABLED=false
RESEARCH_CHAT_CLARIFICATION_ENABLED=false
RESEARCH_CHAT_DECISION_OUTPUT_ENABLED=false
RESEARCH_CHAT_RAW_REASONING_PERSIST=false
RESEARCH_CHAT_CONNECT_TIMEOUT_SECONDS=10
RESEARCH_CHAT_READ_TIMEOUT_SECONDS=90
RESEARCH_CHAT_TOTAL_TIMEOUT_SECONDS=120
RESEARCH_CHAT_TOOL_TIMEOUT_SECONDS=5
RESEARCH_CHAT_MAX_TOOL_CALLS=12
RESEARCH_CHAT_MAX_TOOL_ROUNDS=4
RESEARCH_CHAT_MAX_CONCURRENCY=2
RESEARCH_CHAT_MAX_OUTPUT_TOKENS=12000
RESEARCH_CHAT_HEARTBEAT_SECONDS=15
# Current DeepSeek API models. Keep these configurable so model upgrades do not require code changes.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_SECONDS=0.5
DEEPSEEK_MAX_CONCURRENCY=4
DEEPSEEK_CONCURRENCY_WAIT_SECONDS=1
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=3
DEEPSEEK_CIRCUIT_RESET_SECONDS=60
# Keep false unless the API container must explicitly use HTTP_PROXY/HTTPS_PROXY.
DEEPSEEK_TRUST_ENV_PROXY=false
AI_ANALYSIS_PROMPT_VERSION=news-analysis-prompt-v2
AI_ANALYSIS_SCHEMA_VERSION=news-analysis-schema-v2
AI_ANALYSIS_SCHEMA_RETRIES=1
AI_ANALYSIS_MAX_TOKENS=900
# Python package mirror used when building the API image. Change these if needed.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# The public HTTPS address of this API, without a trailing slash.
APP_PUBLIC_BASE_URL=https://api.example.com
# Optional static APK directory URL, without a trailing slash.
# Example: https://groupim.cn/third-hand/releases
# Leave empty to keep using APP_PUBLIC_BASE_URL/v1/app-update/apk.
APP_UPDATE_PUBLIC_BASE_URL=
# The deployment workflow updates these values after uploading a signed APK.
APP_UPDATE_APK_FILE=
APP_UPDATE_VERSION_CODE=1
APP_UPDATE_VERSION_NAME=0.1.0
APP_UPDATE_CHANGELOG=
