# Copy this file to .env on the deployment server. Never commit the real .env.
API_PORT=8000
# Optional personal-research A-share end-of-day provider. Never commit a real token.
THIRD_HAND_MARKET_PROVIDER=akshare
TUSHARE_TOKEN=
# Python package mirror used when building the API image. Change these if needed.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
